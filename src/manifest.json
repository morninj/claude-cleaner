{
  "manifest_version": 3,
  "name": "Claude Cleaner",
  "version": "1.1.0.8",
  "description": "Remove your Claude chat history with one click. Adds a 'Delete all chats' button to claude.ai.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
